local function AutoCompleteTarget(typed)
    if typed == "" then
        currentTarget = nil
        SelectorGui.Enabled = false
        return
    end

    local lower = string.lower(typed)
    local matches = {}

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local nameLow = string.lower(plr.Name)
            local dispLow = string.lower(plr.DisplayName)
            if string.sub(nameLow, 1, #lower) == lower or string.sub(dispLow, 1, #lower) == lower then
                table.insert(matches, plr)
            end
        end
    end

    if #matches == 1 then
        currentTarget = matches[1]
        if _G.TargetBoxRef then _G.TargetBoxRef.Text = matches[1].Name end
        SelectorGui.Enabled = false
        ShowNotification("الاستهداف | Target", "تم اختيار اللاعب: " .. matches[1].Name, "success")
    elseif #matches > 1 then
        ShowPlayerSelector(matches)
    else
        currentTarget = nil
        SelectorGui.Enabled = false
    end
end

