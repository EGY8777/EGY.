local selectedPack = nil
local applyToken = 0

local function ApplyPack(packName)
    local pack = AnimPacks[packName]
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local animate = character and character:FindFirstChild("Animate")

    if not pack or not humanoid or not animate then
        ShowNotification("الأنيميشن", "الشخصية أو سكربت Animate غير متاح", "error")
        return false
    end

    if humanoid.RigType ~= Enum.HumanoidRigType.R15 then
        ShowNotification("الأنيميشن", "هذه الحزم تعمل على R15 فقط", "error")
        return false
    end

    applyToken += 1
    local myToken = applyToken

    local changed = 0
    for _, slot in ipairs(Slots) do
        local folder = animate:FindFirstChild(slot[1])
        local anim = folder and folder:FindFirstChild(slot[2])
        if anim and anim:IsA("Animation") then
            anim.AnimationId = "rbxassetid://" .. tostring(pack[slot[3]])
            changed += 1
        end
    end

    if changed == 0 then
        ShowNotification("الأنيميشن", "اللعبة تستخدم نظام أنيميشن مخصص", "error")
        return false
    end

    local animator = humanoid:FindFirstChildOfClass("Animator")
    pcall(function()
        animate.Disabled = true
        if animator then
            for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
                t:Stop(0)
            end
        end
        task.wait(0.1)
        animate.Disabled = false
    end)

    if myToken ~= applyToken then return false end

    selectedPack = packName
    ShowNotification("الأنيميشن", "تم اختيار " .. packName, "success")
    return true
end

