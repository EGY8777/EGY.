local _, FlingBtn, FlingIndicator = CreateToggleRow(TargetPage, "Fling | طرد الهدف")
local function FlingTarget(targetChar)
    if not targetChar then return end
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    local myChar = LocalPlayer.Character
    local myRoot = getMyRoot()
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if not targetRoot or not myRoot or not myHum then return end

    local bAV = Instance.new("BodyAngularVelocity")
    bAV.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bAV.AngularVelocity = Vector3.new(999999, 999999, 999999)
    bAV.P = math.huge
    bAV.Parent = myRoot

    myHum:ChangeState(Enum.HumanoidStateType.Physics)

    local startTime = tick()
    local flingConn
    flingConn = RunService.Heartbeat:Connect(function()
        if not targetRoot or not myRoot or not targetRoot.Parent then return end
        myRoot.CFrame = targetRoot.CFrame * CFrame.new(math.random(-1, 1), math.random(-1, 1), math.random(-1, 1))
        myRoot.AssemblyLinearVelocity = Vector3.new(999999, 999999, 999999)
        myRoot.AssemblyAngularVelocity = Vector3.new(999999, 999999, 999999)
    end)

    while tick() - startTime < 1.5 do
        task.wait()
    end

    if flingConn then flingConn:Disconnect() end
    bAV:Destroy()
    myHum:ChangeState(Enum.HumanoidStateType.GettingUp)
end

