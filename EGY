    local myChar = LocalPlayer.Character
    local myRoot = getMyRoot()
    if not myChar or not myRoot then return end

    FlingBtn.BackgroundColor3 = Color3.fromRGB(80, 180, 80)
    FlingIndicator.ImageColor3 = Color3.fromRGB(0, 255, 0)
    ShowNotification("الفلينج | Fling", "جاري تنفيذ الفلينج...", "info")

    task.spawn(function()
        local originalPos = myRoot.CFrame
        FlingTarget(currentTarget.Character)
        if myRoot and myRoot.Parent then
            myRoot.CFrame = originalPos
            myRoot.AssemblyLinearVelocity = Vector3.zero
            myRoot.AssemblyAngularVelocity = Vector3.zero
        end
        FlingBtn.BackgroundColor3 = Color3.fromRGB(160, 160, 160)
        FlingIndicator.ImageColor3 = Color3.fromRGB(120, 120, 120)
